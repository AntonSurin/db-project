table "report"."custom_print_form_report" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_report"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('report.custom_print_form_report_id_seq'::regclass)
    }
    column "name" {
      type = character varying(150)
      null = NOT NULL
    }
    column "value" {
      type = text
      null = NOT NULL
    }
    column "old_value" {
      type = text
    }
    column "type" {
      type = smallint
      null = NOT NULL
      default = 0
    }
    column "parameters" {
      type = character varying(100)
    }
  )
}

