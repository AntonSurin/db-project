table "report"."type" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_report_type"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('report.type_id_seq'::regclass)
    }
    column "name" {
      type = character varying(50)
    }
  )
}

