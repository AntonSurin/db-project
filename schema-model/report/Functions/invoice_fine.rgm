function "report"."invoice_fine(jsonb, integer, numeric, integer)" {
  text = """

declare
	_period_name 			varchar(50);
	_date_begin 			date;
	_parametr_id			int;
	_bar_code_period_name	varchar(50);
	_commission				int;
	_minimal_persent 		numeric(10,5);
	_bank_perсent 			numeric(10,5);
	_val 					text = '';
	_json 					text = '';
begin

	select pl.name_month || ' ' || pl."year" || ' г.', pl.date_begin, lpad(pl.month_id::text,2,'0') || right(pl."year"::text, 1)
	into _period_name, _date_begin, _bar_code_period_name
	from "period".list pl
	where pl.id = _period_id;

	_json = (
				select coalesce(parameters, '')
				from report.list
				where id = 1
			);

	with cte as 
	(
		select
			 max(case when (lower(d.value::text)::jsonb ->> 'name') = 'bankperсent' then (lower(d.value::text)::jsonb ->> 'value') end) as bank_perсent
			,max(case when (lower(d.value::text)::jsonb ->> 'name') = 'minimalpersent' then (lower(d.value::text)::jsonb ->> 'value') end) as minimal_persent
			,max(case when (lower(d.value::text)::jsonb ->> 'name') = 'infotext' then (lower(d.value::text)::jsonb ->> 'value') end) as value
		from report.list as l
			left join lateral (select *
							   from jsonb_array_elements(l.parameters ::jsonb)
							  ) as d on 1 = 1
		where l.id = 1
	)
	
	select coalesce(minimal_persent::numeric(10,5), 0), coalesce(bank_perсent::numeric(10,5), 0), coalesce(regexp_replace(value,'\n\r', ' '), '')
	into _minimal_persent, _bank_perсent, _val 
	from cte;

	_commission = (select id from parametr.list where lower(short_name) = 'commission');

	drop table if exists __account;
	create table __account (account_id int primary key not null, account_parent_id int not null);
	
	if (_group_id is null)
		then
			begin
				insert into __account (account_id, account_parent_id)
				select aa.id, aa.parent_id
				from adress.account aa
					inner join jsonb_populate_recordset(null::account.list, _account) a on a.account_id = aa.parent_id;
			end; 
		else 
			begin
				insert into __account (account_id, account_parent_id)
				select aa.id, aa.parent_id
				from adress.account aa
					inner join jsonb_populate_recordset(null::account.list, _account) a on a.account_id = aa.parent_id
				where aa.group_id = _group_id;
			end;
	end if;

	return query
	with cte as 
	(
		select 
			 ai.account_id
			,ai.account_name
			,ai.short_name_flat
			,ot.short_name || ol.short_name as organization_name
			,ol.inn
			,ol.kpp
			,oc.rs
			,oc.ks
			,oc.bik
			,oc.bank_name
			,oc.bank_adress
			,(
				select string_agg(cl.full_name, ', ')
				from contragent.list cl
					inner join contragent.account ca on ca.contragent_id = cl.id
					inner join contragent.owner_documents od on ca.id = od.contragent_account_id
				where ca.account_id = ai.account_id and ca.is_responsible = true and coalesce(od.date_end, _date_begin) >= _date_begin
			) as owner
			,ol.phone::text
			,ol.email::text
			,sum(pb.in_balance) as in_balance
			,sum(pb.current_calculate + pb.recalculate) as calc
			,sum(pb.pay) as pay
			,_period_name as period_name
			,_date_begin as date_begin
			,_val as anotation
			,'1' 
				|| right('00000000' 
				|| cast(cast((sum(pb.in_balance + pb.current_calculate + pb.recalculate - pb.pay)) * 100 as int) as varchar(8)), 8) 
				|| _bar_code_period_name 
				|| ai.account_name 
			as bar
			,_minimal_persent as minimal_percent
			,_bank_perсent as bank_percent
			,cast(c.value as numeric(5, 2)) as commission
			,ai.order_id
			,ai.account_order_id
			,sum(pb.in_balance) + sum(pb.current_calculate + pb.recalculate) - sum(pb.pay) as filter_column
			from __account a
				inner join payment.balance pb on pb.account_id = a.account_id
				inner join adress.info ai on ai.account_id = a.account_parent_id
				inner join organization.list ol on ol.id = ai.organization_id
				inner join organization.counting oc on oc.id = ai.counting_id
				inner join organization."type" ot on ot.id = ol.type_id
				left join lateral	(
										select p.value 
										from parametr.account p
										where p.account_id = ai.account_id and p.parametr_id = _commission and p.date_end is null
										limit 1
									) c on true
			where pb.sublist_id = 7 and period_id = _period_id
			group by ai.account_id, ai.account_name, ai.short_name_flat, ot.short_name, ol.short_name, ol.inn, ol.kpp, oc.rs, oc.ks, oc.bik, oc.bank_name,
				oc.bank_adress, ol.phone, ol.email, ai.order_id, ai.account_order_id, c.value
		)
	
		select *
		from cte c 
		where c.filter_column > _sum;
	
		drop table __account;
	
end;
"""
  returnType = TABLE(account_id integer, account_name character varying, short_name_flat text, organization_name text, inn character varying, kpp character varying, rs character varying, ks character varying, bik character varying, bank_name character varying, bank_adress character varying, owner text, phone text, email text, in_balance numeric, calc numeric, pay numeric, period_name character varying, date_begin date, anotation text, bar text, minimal_percent numeric, bank_percent numeric, commission numeric, order_id integer, account_order_id integer, filter_column numeric)
  arguments = <
    {
      name = _account
      type = jsonb
      mode = IN
    }

    {
      name = _period_id
      type = integer
      mode = IN
      default = 34
    }

    {
      name = _sum
      type = numeric
      mode = IN
      default = 0.0
    }

    {
      name = _group_id
      type = integer
      mode = IN
      default = NULL::integer
    }

  >
  language = plpgsql
  owner = postgres
  comment = """-
=============================================
 Author:		Глещинский Д.В.
 Create date: 10.10.2016
 Description:	Квитанция по пени
 =============================================
"""
}

