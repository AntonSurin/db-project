function "report"."get_meters_domostroi(jsonb, integer)" {
  text = """


	select 
		cl.id as meter_id,
		case 
			when cl.sublist_id = 22 then 1
			when cl.sublist_id = 24 then 2
			when cl.sublist_id in (27, 28, 42) then 3
			when cl.sublist_id = 58 then 4
			when cl.sublist_id = 38 then 5
		end as meter_type,
		us."name" || ' №' || cast(cl."number" as varchar (4)) as meter_name,
		aa."name" as account_id,
		aa."name" as account_name,
		coalesce (cl.verification_date, '2021-01-01') approve_date,
		1 as installation,
		coalesce(cf.value, cf.prev_value) as readings_t,
		coalesce(cf."date", cf.prev_date) as readings_date
	from counter.list cl
		inner join utility.sublist us on us.id = cl.sublist_id 
		inner join counter.account ca on ca.counter_id = cl.id
		inner join jsonb_populate_recordset(null::account.list, _account) a on a.account_id = ca.account_id
		inner join adress.account aa on aa.id = a.account_id
		inner join counter.flow cf on cf.counter_id = cl.id
	where cl.active = true and cl.sublist_id in (22, 24, 27, 28, 42, 38, 58) and cf.period_id = _period_id;
--22 - хв
--24 - гвс
--27 - ээ только одноставочный
--28,42 - двухставочных
"""
  returnType = TABLE(meter_id integer, meter_type integer, meter_name text, account_id character varying, account_name character varying, approve_date date, installation integer, readings_t numeric, readings_date date)
  arguments = <
    {
      name = _account
      type = jsonb
      mode = IN
    }

    {
      name = _period_id
      type = integer
      mode = IN
    }

  >
  language = sql
  owner = postgres
  comment = """-
=============================================
 author:		казакова с. и.
 create date: 03.08.2018
 description:	выгрузка в домострой
 =============================================
"""
}

