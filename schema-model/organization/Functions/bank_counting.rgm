function "organization"."bank_counting()" {
  text = """

begin
	
    insert into bank.counting (bank_id, counting_id, code)
	select bl.id, i.id, '' 
	from bank.list bl
		inner join inserted i on  1 = 1 ;

	return null;

end;
"""
  returnType = trigger
  arguments = [
  ]
  language = plpgsql
  owner = postgres
  comment = """-
=============================================
 Author:		Глещинский Д.В.
 Create date: 04.04.2016
 Description:	Создание кода для расчетного счета
 =============================================
"""
}

