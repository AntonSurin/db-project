view "adress"."info_1c" {
  text = """-
SELECT ai.account_name,
    ol.inn AS organization_inn,
    ai.short_name AS adress,
    ('Д-'::text || ai.house_id) AS house_id,
    ai.flat_book_short_name AS flat_type,
    ai.flat_name AS flat_number,
        CASE
            WHEN ((pc.person_id IS NULL) OR (pc.surname IS NULL)) THEN ('Собственник лс '::text || (ai.account_name)::text)
            ELSE TRIM(BOTH FROM pc.full_name)
        END AS full_name,
    pc.type AS customer_type,
        CASE
            WHEN (TRIM(BOTH FROM pc.inn) = ''::text) THEN NULL::text
            ELSE TRIM(BOTH FROM pc.inn)
        END AS customer_inn,
        CASE
            WHEN (pc.contract_id IS NOT NULL) THEN
            CASE
                WHEN (TRIM(BOTH FROM pc.inn) = ''::text) THEN NULL::text
                ELSE TRIM(BOTH FROM pc.inn)
            END
            ELSE NULL::text
        END AS contract_inn,
    pc.contract_id
   FROM ((adress.info ai
     JOIN organization.list ol ON ((ol.id = ai.organization_id)))
     LEFT JOIN LATERAL ( SELECT cl.inn,
            c.id AS contract_id,
            cl.surname,
            cl.name,
            cl.middlename,
            cl.type,
            cl.full_name,
            ca.id AS person_id
           FROM ((((contragent.account ca
             JOIN adress.account aa ON ((aa.id = ca.account_id)))
             JOIN contragent.owner_documents od ON ((od.contragent_account_id = ca.id)))
             JOIN contragent.list cl ON ((cl.id = ca.contragent_id)))
             LEFT JOIN LATERAL ( SELECT cc.id
                   FROM (contragent.contract cc
                     JOIN contragent.contract_account ac ON ((ac.contract_id = cc.id)))
                  WHERE ((ac.account_id = ca.account_id) AND (cc.date_end IS NULL))) c ON (true))
          WHERE ((ca.is_responsible = true) AND (od.date_end IS NULL) AND (ca.account_id = ai.account_id))
          ORDER BY cl.id
         LIMIT 1) pc ON (true))
  WHERE (ai.account_parent_id IS NULL)
UNION
 SELECT ai.account_name,
    ol.inn AS organization_inn,
    ai.short_name AS adress,
    ('Д-'::text || ai.house_id) AS house_id,
    ai.flat_book_short_name AS flat_type,
    ai.flat_name AS flat_number,
        CASE
            WHEN ((pc.person_id IS NULL) OR (pc.surname IS NULL)) THEN ('Собственник лс '::text || (ai.account_name)::text)
            ELSE TRIM(BOTH FROM pc.full_name)
        END AS full_name,
    pc.type AS customer_type,
        CASE
            WHEN (TRIM(BOTH FROM pc.inn) = ''::text) THEN NULL::text
            ELSE TRIM(BOTH FROM pc.inn)
        END AS customer_inn,
        CASE
            WHEN (pc.contract_id IS NOT NULL) THEN
            CASE
                WHEN (TRIM(BOTH FROM pc.inn) = ''::text) THEN NULL::text
                ELSE TRIM(BOTH FROM pc.inn)
            END
            ELSE NULL::text
        END AS contract_inn,
    pc.contract_id
   FROM ((adress.info ai
     JOIN organization.list ol ON ((ol.id = ai.work_id)))
     LEFT JOIN LATERAL ( SELECT cl.inn,
            c.id AS contract_id,
            cl.surname,
            cl.name,
            cl.middlename,
            cl.type,
            cl.full_name,
            ca.id AS person_id
           FROM ((((contragent.account ca
             JOIN adress.account aa ON ((aa.id = ca.account_id)))
             JOIN contragent.owner_documents od ON ((od.contragent_account_id = ca.id)))
             JOIN contragent.list cl ON ((cl.id = ca.contragent_id)))
             LEFT JOIN LATERAL ( SELECT cc.id
                   FROM (contragent.contract cc
                     JOIN contragent.contract_account ac ON ((ac.contract_id = cc.id)))
                  WHERE ((ac.account_id = ca.account_id) AND (cc.date_end IS NULL))) c ON (true))
          WHERE ((ca.is_responsible = true) AND (od.date_end IS NULL) AND (ca.account_id = ai.account_id))
          ORDER BY cl.id
         LIMIT 1) pc ON (true))
  WHERE (ai.account_parent_id IS NULL);
"""
  kind = MATERIALIZED
  owner = postgres
  columns = (
    column "account_name" {
      type = character varying(12)
    }
    column "organization_inn" {
      type = character varying(12)
    }
    column "adress" {
      type = text
    }
    column "house_id" {
      type = text
    }
    column "flat_type" {
      type = character varying(10)
    }
    column "flat_number" {
      type = character varying(30)
    }
    column "full_name" {
      type = text
    }
    column "customer_type" {
      type = boolean
    }
    column "customer_inn" {
      type = text
    }
    column "contract_inn" {
      type = text
    }
    column "contract_id" {
      type = integer
    }
  )
}

