table "adress"."street_book" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_sprav_street"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('adress.street_book_id_seq'::regclass)
    }
    column "name" {
      type = character varying(255)
      null = NOT NULL
    }
    column "short_name" {
      type = character varying(30)
      null = NOT NULL
    }
  )
}

