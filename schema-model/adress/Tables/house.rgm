table "adress"."house" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_house"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('adress.house_id_seq'::regclass)
    }
    column "street_id" {
      type = integer
      null = NOT NULL
    }
    column "inner_city_district_id" {
      type = integer
      null = NOT NULL
      default = 0
    }
    column "house_type_id" {
      type = smallint
      null = NOT NULL
    }
    column "house_kind_id" {
      type = smallint
      null = NOT NULL
    }
    column "territory_id" {
      type = integer
      null = NOT NULL
    }
    column "index" {
      type = character varying(6)
    }
    column "number" {
      type = character varying(10)
    }
    column "korpus" {
      type = character varying(10)
    }
    column "work_id" {
      type = integer
    }
    column "work_counting_id" {
      type = integer
    }
    column "organization_id" {
      type = integer
    }
    column "organization_counting_id" {
      type = integer
    }
    column "order_id" {
      type = integer
    }
    column "hash" {
      type = character varying(50)
    }
    column "address_parser_guid" {
      type = uuid
    }
  )
}

