table "adress"."flat" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_apartment"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('adress.flat_id_seq'::regclass)
    }
    column "house_id" {
      type = integer
      null = NOT NULL
    }
    column "flat_book_id" {
      type = smallint
      null = NOT NULL
    }
    column "name" {
      type = character varying(30)
      null = NOT NULL
    }
    column "gis_name" {
      type = uuid
    }
    column "order_id" {
      type = smallint
    }
    column "address_parser_guid" {
      type = uuid
    }
  )
}

