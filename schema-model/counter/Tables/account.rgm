table "counter"."account" {
  primaryKey = {
    columns = [
      "account_id"
      "counter_id"
    ]
    name = "pk_account_3"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "account_id" {
      type = integer
      null = NOT NULL
    }
    column "counter_id" {
      type = integer
      null = NOT NULL
    }
  )
}

foreignKey "counter"."account"."fk_account_counter_account" {
  columns = [
    "account_id"
  ]
  referencedTable = "adress"."account"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
  onDelete = CASCADE
}

foreignKey "counter"."account"."fk_account_counter_list" {
  columns = [
    "counter_id"
  ]
  referencedTable = "counter"."list"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
  onDelete = CASCADE
}

index "counter"."account_ix_account_account_id" {
  table = "counter"."account"
  type = btree
  columns = <
    {
      definition = account_id
    }

