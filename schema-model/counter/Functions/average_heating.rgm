function "counter"."average_heating(jsonb)" {
  text = """

declare 
		_year 		int;
		_period_id 	int;
		_date_begin date;
		_date_end 	date;
		_month_id 	int2;
		_row_max 	int;
		_new_date 	date;
begin

	drop table if exists _houses;

	create temp table _houses (house_id int not null primary key);

	insert into _houses
	select h.house_id 
	from jsonb_populate_recordset(null::house.list, _house) h;

	select  id, year, date_begin, date_end, month_id 
	into _period_id, _year, _date_begin, _date_end, _month_id
	from "period".list
	where is_working = true;

	_new_date =	(
					case 
						when current_date > _date_end or current_date < _date_begin 
						then _date_end 
						else current_date 
					end
				);

	drop table if exists _periods;
	
	create temp table _periods 
	(
		house_id int, 
		period_id int
	); /* заполняем таблицу отопительных периодов по действующим месяцам в базе */

	with os as 
	(
		select ca.house_id, ca.period_id, max(ca.otopsezon) as otop_sezon 
		from calculation.parametr_transporate_arch ca 
			inner join _houses hs on hs.house_id = ca.house_id
		group by ca.house_id, ca.period_id
		union all
		select ah.id as house_id, pl.id as period_id,
			case
				when coalesce(p.otop_off,0) = 1 
					then 0
				when (pl.month_id >= coalesce(te.month_begin,10) or pl.month_id <= coalesce(te.month_end,4)) or coalesce(p.otop_off,0) > 1
					then 1
				else 0
			end as otop_sezon
		from adress.territory te
			inner join "period".list pl on pl.is_working = true
			inner join adress.house ah on ah.territory_id = te.id
			inner join _houses h on h.house_id = ah.id
			left join	(
							select ph.house_id, coalesce(ph.value,'0')::int2 as otop_off
							from parametr.house ph
								inner join _houses h on h.house_id = ph.house_id
							where ph.parametr_id = 201 and ph.date_end is null
						) p on p.house_id = ah.id
	)

	insert into _periods
	select house_id, period_id 
	from (
			select house_id, period_id, row_number () over (partition by house_id order by house_id asc, period_id desc) rn
			from (
					select h.house_id, pl.id as period_id
					from adress.house ah 
						inner join _houses h on h.house_id = ah.id 
						inner join adress.territory ta on ta.id = ah.territory_id
						inner join "period".list pl on pl.month_id not between ta.month_end + 1 and ta.month_begin - 1
						left join os on os.house_id = ah.id and os.period_id = pl.id
					where pl.id <= _period_id and pl.is_open = true and coalesce(os.otop_sezon,1) != 0
					union 
					select os.house_id, pl.id as period_id
					from os 
						inner join "period".list pl on pl.id = os.period_id
					where pl.id <= _period_id and pl.is_open = true and os.otop_sezon = 1
					) p 
		) pp where pp.rn <= 7;

	drop table if exists _account_open_t;
	
	create table _account_open_t 
	(
		account_id 		int not null primary key, 
		house_id 		int not null, 
		account_open 	int2
	);

	insert into _account_open_t
	select 	p.account_id, 
			h.house_id,
			sum((case when p.value = '1' then 1 else 0 end) * 
				(
				 (
					(case when coalesce(p.date_end,pl.date_end) > pl.date_end then pl.date_end else coalesce(p.date_end,pl.date_end) end) 
					- 
					(case when p.date_begin < pl.date_begin then pl.date_begin else p.date_begin end)
			     ) + 1
			    )
			   ) as account_open
	from parametr.account p
		inner join "period".list pl on pl.is_working = true
		inner join adress.account aa on aa.id = p.account_id
		inner join _houses h on h.house_id = aa.house_id
	where parametr_id = 1362 
		and coalesce(p.date_end,pl.date_end) >= (case when p.date_begin < pl.date_begin then pl.date_begin else p.date_begin end)
		and p.date_begin <= (case when coalesce(p.date_end,pl.date_end) > pl.date_end then pl.date_end else coalesce(p.date_end,pl.date_end) end)
	group by p.account_id, h.house_id
	having sum((case when p.value = '1' then 1 else 0 end) * 
				(
				 (
					(case when coalesce(p.date_end,pl.date_end) > pl.date_end then pl.date_end else coalesce(p.date_end,pl.date_end) end)
					-
					(case when p.date_begin < pl.date_begin then pl.date_begin else p.date_begin end)
				 ) + 1
				)
			   ) > 0;

	drop table if exists _counter_t;

	create temp table _counter_t 
	(
		counter_id 		int not null primary key, 
		house_id 		int, 
		account_id 		int not null, 
		sublist_id 		int, 
		list_id 		int, 
		"number" 		int2, 
		verify_date 	date, 
		failure_date 	date
	);

	insert into _counter_t
	select 	cf.counter_id, 
			oa.house_id, 
			ca.account_id, 
			cf.sublist_id, 
			us.list_id, 
			cl."number", 
			(cl.verification_date + interval'1 year' * cl.verification_interval) as verify_date, 
			cl.failure_date 
	from counter.flow cf
		inner join counter.account ca on ca.counter_id = cf.counter_id
		inner join counter.list cl on cf.counter_id = cl.id
		inner join _account_open_t oa on oa.account_id = ca.account_id  
		inner join utility.sublist us on us.id = cl.sublist_id
		inner join	(
						select sga.account_id, sga.avg_type as aavg, sgh.avg_type as havg, sgi.sublist_id
						from utility.sublist_group_a_detail sga
							inner join utility.sublist_group_h_detail sgh on sgh.group_id = sga.group_id and sga.house_id = sgh.house_id
							inner join utility.sublist_group_info sgi on sgi.group_id = sgh.group_id
							inner join _account_open_t oa on oa.account_id = sga.account_id
						where sga.period_id is null and sgi.sublist_id = 38 and sgh.avg_type = true and sga.avg_type = true
					) a on a.account_id = ca.account_id and a.sublist_id = cf.sublist_id
		inner join adress.house ah on ah.id = oa.house_id
	where period_id = _period_id 
			and cl.sublist_id = 38
			and cl.active = true;

	drop table if exists _counter_ta;

	create temp table _counter_ta 
	(
		counter_id 	int not null primary key, 
		house_id 	int not null, 
		period_id 	int not null
	);

	insert into _counter_ta
	select c.counter_id, c.house_id, max(c.period_id) as period_id 
	from 
	(
		select cf.counter_id, ct.house_id, max(cf.period_id) + 1 as period_id
		from counter.flow cf
			inner join _counter_t ct on ct.counter_id = cf.counter_id
			inner join _periods p on p.period_id = cf.period_id and p.house_id = ct.house_id
		where coalesce(flow_type_id,0) not in (0, 3, 4) and cf.period_id < _period_id 
		group by cf.counter_id, ct.house_id
		union all
		select cf.counter_id, ca.house_id, max(cf.period_id) as period_id
		from counter.flow cf
			inner join _counter_t ca on ca.counter_id = cf.counter_id
			inner join "period".list pl on pl.id = cf.period_id
		where period_id < _period_id and ca.verify_date between pl.date_begin and pl.date_end
		group by cf.counter_id, ca.house_id
		union all
		select cf.counter_id, ca.house_id, max(cf.period_id) as period_id
		from counter.flow cf
			inner join _counter_t ca on ca.counter_id = cf.counter_id
			inner join "period".list pl on pl.id = cf.period_id
		where period_id < _period_id and ca.failure_date between pl.date_begin and pl.date_end 
		group by cf.counter_id, ca.house_id
	) c
	group by c.counter_id, c.house_id;

	/* выбираем  необходимые счетчики */
	/*
		avg_type:
		1 - по среднему если закончился срок поверки
		2 - по нормативу
		3 - по среднему
	*/
	
	return query
	select c.counter_id
		,c.sublist_id
		,c.account_id
		,coalesce(cnt_a.cnt_avg, 0)::int as cnt_avg 
		,cnt_w.cnt_work::int
		,cnt_w.sum_f
		,case
			when verify_date < _new_date or failure_date < _new_date
			then 
				case 
					when coalesce(cnt_a.cnt_avg, 0) >= 3 or cnt_w.cnt_work <= 3
					then 2::int2
					else 1::int2
				end
			else 
				case 
					when coalesce(cnt_a.cnt_avg, 0) >= 3 or cnt_w.cnt_work <= 3
					then 2::int2
					else 3::int2
				end
		end as avg_type
		,c."number"::int2
	from _counter_t c
		inner join 
			(
				select 
					cf.counter_id, 
					sum(case when coalesce(flow_type_id,0) <> 5 then 1 else 0 end) as cnt_work, 
					sum(cf.flow) as sum_f
				from counter.flow cf
					inner join _counter_t ct on ct.counter_id = cf.counter_id
					inner join _periods p on p.period_id = cf.period_id and p.house_id = ct.house_id
				where coalesce(flow_type_id,0) <> 5
				group by cf.counter_id
			) cnt_w on cnt_w.counter_id = c.counter_id
		left join 
			(
				select cf.counter_id, count(cf.period_id) as cnt_avg
				from counter.flow cf
					inner join _counter_ta ta on ta.counter_id = cf.counter_id
					inner join _periods p on p.period_id = cf.period_id and p.house_id = ta.house_id
				where coalesce(flow_type_id,0) in (0, 3, 4) and cf.period_id between ta.period_id and _period_id-1 
				group by cf.counter_id
			) cnt_a on cnt_a.counter_id = c.counter_id
	union all
	/*	добавляем счетчики, которые были созданы в рабочем/неотопительном периоде с соответствующим признаком - начисление по нормативу	*/
	select ct.counter_id, ct.sublist_id, ct.account_id, 0 as cnt_avg, 0 as cnt_work, 0.0 as sum_f, 2::int2 as avg_type, ct."number"
	from _counter_t ct
		inner join counter.flow cf on ct.counter_id = cf.counter_id
		inner join (
						select house_id, max(period_id) as period_id 
						from _periods 
						where period_id < _period_id 
						group by house_id
					) p on p.house_id = ct.house_id
		where cf.period_id between p.period_id and _period_id - 1
			and coalesce(cf.flow_type_id,0) = 5;

	drop table if exists _account_open_t;
	drop table if exists _counter_ta;
	drop table if exists _counter_t;
	drop table if exists _periods;
	drop table if exists _houses;
	
end;
"""
  returnType = TABLE(counter_id integer, sublist_id integer, account_id integer, cnt_avg integer, cnt_work integer, sum_f numeric, avg_type smallint, number smallint)
  arguments = <
    {
      name = _house
      type = jsonb
      mode = IN
    }

  >
  language = plpgsql
  owner = postgres
  comment = """-
=============================================
 Author:		Глещинский Д.В., Юркин Е.Ю.
 Create date: 28.02.2019
 Modify date: 01.04.2023 - Юркин. Кол-во месяцев начисления по среднему при выходе из строя/поверке
 Description:	Процедура для получения списка счетчиков по отоплению для начисления по среднему
 =============================================
"""
}

