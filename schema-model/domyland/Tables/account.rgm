table "domyland"."account" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_account_5"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('domyland.account_id_seq'::regclass)
    }
    column "account_id" {
      type = integer
      null = NOT NULL
    }
    column "domyland_id" {
      type = uuid
      null = NOT NULL
    }
    column "status" {
      type = boolean
      null = NOT NULL
    }
  )
}

