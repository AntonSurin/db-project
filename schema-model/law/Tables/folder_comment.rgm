table "law"."folder_comment" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_folder_comment"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('law.folder_comment_id_seq'::regclass)
    }
    column "folder_id" {
      type = integer
      null = NOT NULL
    }
    column "text" {
      type = text
      null = NOT NULL
    }
  )
}

foreignKey "law"."folder_comment"."fk_comment_folder" {
  columns = [
    "folder_id"
  ]
  referencedTable = "law"."folder"
  referencedColumns = [
    "id"
  ]
  onDelete = CASCADE
}

