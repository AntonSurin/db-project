table "tarif"."list" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_list_5"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('tarif.list_id_seq'::regclass)
    }
    column "name" {
      type = character varying(100)
    }
    column "provider_id" {
      type = integer
      null = NOT NULL
    }
    column "sublist_id" {
      type = integer
      null = NOT NULL
    }
    column "territory_id" {
      type = integer
      null = NOT NULL
    }
    column "value" {
      type = numeric(10,2)
    }
    column "document" {
      type = character varying(200)
    }
    column "is_global" {
      type = boolean
    }
  )
}

foreignKey "tarif"."list"."fk_list_provider" {
  columns = [
    "provider_id"
  ]
  referencedTable = "utility"."provider"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
}

foreignKey "tarif"."list"."fk_list_sub_list" {
  columns = [
    "sublist_id"
  ]
  referencedTable = "utility"."sublist"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
}

foreignKey "tarif"."list"."fk_list_territory" {
  columns = [
    "territory_id"
  ]
  referencedTable = "adress"."territory"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
}

index "tarif"."list_ix_list_sub_list_id" {
  table = "tarif"."list"
  type = btree
  columns = <
    {
      definition = sublist_id
    }

  >
  isUnique = False
  includeColumns = [
    provider_id
    value
  ]
}

index "tarif"."list_ix_territory_id" {
  table = "tarif"."list"
  type = btree
  columns = <
    {
      definition = territory_id
    }

  >
  isUnique = False
  includeColumns = [
    provider_id
    value
    sublist_id
  ]
}

