table "gis"."voting_protocol" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_voting_protocol"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('gis.voting_protocol_id_seq'::regclass)
    }
    column "guid" {
      type = uuid
      null = NOT NULL
    }
    column "num" {
      type = character varying(30)
      null = NOT NULL
    }
    column "date" {
      type = timestamp(3) without time zone
      null = NOT NULL
    }
    column "status_gis" {
      type = character varying(10)
      null = NOT NULL
    }
  )
}

