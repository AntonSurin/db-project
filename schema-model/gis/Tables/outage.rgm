table "gis"."outage" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_outage"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('gis.outage_id_seq'::regclass)
    }
    column "status" {
      type = integer
      null = NOT NULL
    }
    column "object_type" {
      type = integer
      null = NOT NULL
    }
    column "start_date" {
      type = timestamp(3) without time zone
      null = NOT NULL
    }
    column "end_date" {
      type = timestamp(3) without time zone
    }
    column "outage_gis_guid" {
      type = uuid
    }
    column "cancelled_date" {
      type = timestamp(3) without time zone
    }
    column "published_date" {
      type = timestamp(3) without time zone
    }
    column "outage_kind_guid" {
      type = uuid
      null = NOT NULL
    }
    column "outage_type" {
      type = integer
      null = NOT NULL
    }
    column "outage_reason_guid" {
      type = uuid
      null = NOT NULL
    }
    column "outage_reason_text" {
      type = character varying(1000)
    }
    column "additional_info" {
      type = character varying(1000)
    }
    column "cancelled_reason" {
      type = character varying(1000)
    }
    column "is_edit" {
      type = boolean
      null = NOT NULL
    }
    column "is_from_gis" {
      type = boolean
      null = NOT NULL
    }
  )
}

