table "gis"."filter" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_filter"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('gis.filter_id_seq'::regclass)
    }
    column "name" {
      type = character varying(50)
      null = NOT NULL
    }
    column "value" {
      type = character varying(500)
      null = NOT NULL
    }
    column "is_default" {
      type = boolean
      null = NOT NULL
    }
    column "type_name" {
      type = character varying(50)
      null = NOT NULL
    }
  )
}

