table "gis"."organization_house" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_organization_house"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('gis.organization_house_id_seq'::regclass)
    }
    column "organization_setting_id" {
      type = integer
      null = NOT NULL
    }
    column "house_id" {
      type = integer
      null = NOT NULL
    }
  )
}

foreignKey "gis"."organization_house"."fk_organization_house_organization_settings" {
  columns = [
    "organization_setting_id"
  ]
  referencedTable = "gis"."organization_settings"
  referencedColumns = [
    "id"
  ]
  onDelete = CASCADE
}

