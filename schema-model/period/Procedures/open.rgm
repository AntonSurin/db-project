procedure "period"."open(integer, integer)" {
  text = """

declare 
		_period_is_working_id		int;
		_account					jsonb;
		_column						text = '';
		_sql						text;
		_date_begin					date; 
		_date_end					date;
		_normativ_column			text = '';
		_tarif_column				text = '';
		_volume_column				text = '';
		_sum_volume_column			text = '';
		_close_counter_if_overdue	bool; 
		_reset_parametr 			text = '';
		_update_entity 				text = '';
		_reset_column_tarif 		text = '';
		_reset_column_normativ 		text = '';
		_reset_column_volume 		text = '';
		_reset_column_sum_volume 	text = '';
		_period_id1 			int; 
		_date_end1 			date; 
		_date_begin1 		date;	
		_is_input 			bool;
		_parametr_id 		int;
		_parametr_reg_id 	int;
		_houses 			jsonb;
		_root_id 			int;
		_sublist 			jsonb;
		_odn	boolean;
		_sql1				 	text = '';
		_colt				 	text = '';
		_colt_winth_type	 	text = '';
		_normativ			 	text = '';
		_rate				 	text = '';
		_tarif				 	text = '';
		_volume				 	text = '';
		_date_begin2			 	date;
		_date_end2			 	date;
		_period_id2			 	int;
		_normativ_odn		 	text = '';
		_tarif_odn			 	text = '';
		_volume_odn			 	text = '';
		_input_calc_parametr 	text = '';
		_sublist_filter			text = '';
		_normativ_balance		text = '';
		_volume_balance			text = '';
		_tarif_balance			text = '';
		_calc_column			text = ''; 
		_calc_column_with_type  text = ''; 
		_calc_formula			text = '';
		_rate_balance			text = '';
		_sublist_volume 		text = '';
begin
		
	_odn = true;

	select c.volume_column, c.tarif_column, c.normativ_column, c.sum_volume_column
	into _volume_column, _tarif_column, _normativ_column, _sum_volume_column
	from (
			select 
				 string_agg(case when lower(ic.table_name) = 'volume' then ', ' 	|| ic.column_name else '' end, '') as volume_column 
				,string_agg(case when lower(ic.table_name) = 'tarif' then ', ' 		|| ic.column_name else '' end, '') as tarif_column
				,string_agg(case when lower(ic.table_name) = 'normativ' then ', ' 	|| ic.column_name else '' end, '') as normativ_column
				,string_agg(case when lower(table_name) = 'sum_volume' then ', ' 	|| ic.column_name else '' end, '') as sum_volume_column
			from information_schema."columns" ic
			where lower(ic.table_schema) = 'calculation' and lower(ic.table_name) in ('volume', 'tarif', 'normativ', 'sum_volume')
		) as c;

	_column = (select string_agg(isc.column_name || ',', '') 
				from information_schema."columns" isc
				where lower(isc.table_schema) = 'calculation' and lower(isc.table_name) = 'parametr_transporate_arch' and lower(isc.column_name) <> 'period_id' and lower(isc.column_name) <> 'id');
	
	_sql = '
	insert into calculation.parametr_transporate_arch (' || _column || ' period_id)
		select ' || _column || ' ' || _period_id || ' from calculation.parametr_transporate;
			
	insert into calculation.normativ_arch(period_id' || _normativ_column || ')
		select ' || _period_id || _normativ_column || ' from calculation.normativ;

	insert into calculation.tarif_arch(period_id' || _tarif_column || ')
		select ' || _period_id || _tarif_column || ' from calculation.tarif;

	insert into calculation.volume_arch(period_id' || _volume_column || ')
		select ' || _period_id || _volume_column || ' from calculation.volume;

	insert into calculation.sum_volume_arch(period_id' || _sum_volume_column || ')
		select ' || _period_id || _sum_volume_column || ' from calculation.sum_volume;';

	execute(_sql);

	insert into calculation.account_sublist_arch (period_id, house_id, account_id, account_parent_id, sublist_id, value, "date")
	select _period_id, cas.house_id, cas.account_id, cas.account_parent_id, cas.sublist_id, cas.value, cas."date"
	from calculation.account_sublist cas;

	------- Закрытие тарифов по домам, которые закрыты 3 и более месяцев подряд.
	create temp table _house_tarif (house_id int, tarif_house int);

	insert into _house_tarif (house_id, tarif_house)
	select cp.house_id, th.id
	from calculation.parametr_transporate cp
		inner join "period".list pl on pl.is_working = true
		inner join calculation.parametr_transporate_arch ca on ca.account_id = cp.account_id 
		inner join tarif.house_tarif th on th.house_id = cp.house_id 
		inner join tarif.list tl on tl.id = th.tarif_id
	where ca.period_id between (pl.id - 3) and pl.id 
		and th.date_end is null 
		and th.date_begin < pl.date_end
	group by cp.house_id, th.id
	having max(cp.houseopen) + max(ca.houseopen) = 0 and count(distinct ca.period_id) >= 2;

	if exists (select * from _house_tarif)
		then
			begin
				
				update tarif.house_tarif th 
					set date_end = pl.date_end 
				from _house_tarif ht 
					inner join "period".list pl on pl.is_working = true
				where ht.house_id = th.house_id 
					and ht.tarif_house = th.id 
					and th.date_end is null 
					and th.date_begin < pl.date_end;
				
			end;
	end if;

	drop table if exists _house_tarif;

	_period_is_working_id = (select pl."id" from "period".list pl where pl.is_working = true);

	if _period_is_working_id is null   --находим первый период
		then
			_period_is_working_id = (select pl."id" from "period".list pl where pl.is_open = true order by pl."id" limit 1);
		else --обнуляем текущий и находим следующий период
			begin	
				_period_is_working_id = (select pl."id" from "period".list pl where pl.is_working = true);
			
				update "period".list 
					set is_working = false;
		
				_period_is_working_id = (select pl."id" from "period".list pl where pl."id" > _period_is_working_id order by pl.id limit 1);
			end;
	end if;

	update period.list pl
	set
		is_working = true,
		is_open = true,
		date_open = current_date
	where pl."id" = _period_is_working_id;

	_account=(select jsonb_agg(jsonb_build_object('account_id', aa.id)) 
				from adress.account aa
				where aa.parent_id is null);

	_date_begin = (select pl.date_begin from period.list pl where pl.id = _period_is_working_id);
	_date_end = (select cast (_date_begin + interval '1 month' as date));
		
	----- закрытие счетчиков у которых закрыты лс
	update counter.list cl 
		set active = false
			,date_end = _date_begin - 1
	from calculation.parametr_transporate cp
		inner join counter.account ca on ca.account_id = cp.account_id
	where cl.id = ca.counter_id and is_closed = 0 and cl.active = true;

	------ сдвиг даты поверки счетчиков, заканчивающихся в 2020 на 01.01.2021
	update counter.list cl
		set verification_date = cast(('2021-01-01'::date - interval '1 year'*cl.verification_interval) as date)
	where cl.date_end is null and cl.active = true and cl.verification_interval is not null and cl.verification_date is not null 
				and (verification_date+interval '1 year'*verification_interval) between '2020-01-01'::date and '2020-12-31'::date;

	-------- закрываем счетчики у которых вышла дата поверки более 3-х месяцев назад (кроме электроэнергии)
	create temp table _close_counter_id (counter_id int, verification_interval int, verification_date date, failure_date date, sublist_id int, account_id int, close_type varchar(50));

	insert into _close_counter_id
	select cl.id, cl.verification_interval, cl.verification_date, cl.failure_date, cl.sublist_id, ca.account_id, 'После трех месяцев с даты поверки' as close_type
	from counter.list cl
		inner join utility.sublist us on us.id = cl.sublist_id and us.list_id != 1028
		left join counter.account ca on ca.counter_id = cl.id
	where cl.active = true and cl.date_end is null
		and (cl.verification_date + interval '1 year'*cl.verification_interval) < _date_begin
		and (date_part('month' ,_date_begin) - date_part('month' ,(cl.verification_date + interval '1 year'*cl.verification_interval))) > 3;
	
	/* добавлены счетчики с проставленной датой выхода из строя */
	insert into _close_counter_id
	select cl.id, cl.verification_interval, cl.verification_date, cl.failure_date, cl.sublist_id, ca.account_id, 'После трех месяцев с даты выхода из строя' as close_type
	from counter.list cl
		inner join utility.sublist us on us.id = cl.sublist_id and us.list_id != 1028
		left join counter.account ca on ca.counter_id = cl.id
	where not exists (select * from _close_counter_id ci where ci.counter_id = cl.id)
		and cl.active = true and cl.date_end is null
		and (cl.failure_date + interval '3 month') < _date_begin;

 	_close_counter_if_overdue = (select (case 
						 					when array_to_string(xpath('Root/Calculation/CloseCounterIfOverdue/text()', p.xml_data)::text[] , '')='' 
						 					then 'true' 
						 					else array_to_string(xpath('Root/Calculation/CloseCounterIfOverdue/text()', p.xml_data)::text[], '') 
						 				end)::bool
					 			 from special.parametr p);
	
	if _close_counter_if_overdue = true
		then
			insert into _close_counter_id
			select cl.id, cc.verification_interval, cc.verification_date, cl.failure_date, cl.sublist_id, ca.account_id, 'Все счетчики по услуге если просрочен хотя бы один' as close_type
			from _close_counter_id cc
				inner join counter.account ca on ca.account_id = cc.account_id
				inner join counter.list cl on cl.sublist_id = cc.sublist_id and cl.id = ca.counter_id 
			where not exists (select * from _close_counter_id ci where ci.counter_id = cl.id) and cl.active = true and cl.date_end is null and cl.date_begin < _date_begin;
	end if;

	update counter.list cl
		set active = false,
			date_end = (_date_begin-1)
	from _close_counter_id c 
	where c.counter_id = cl.id;

	---- сохранение id и Period_ID закрытых счетчиков для отката

	merge into counter.closed_verification_date as target 
	using (
			select 
					 cc.counter_id 
					,_period_id as period_id
					,cc.verification_interval
					,cc.verification_date
					,cc.failure_date
					,cc.sublist_id
					,cc.account_id
					,cc.close_type
			from _close_counter_id cc
		)
	as source (counter_id, period_id, verification_interval, verification_date, failure_date, sublist_id, account_id, close_type)
	on (target.counter_id = source.counter_id)
	when matched then
		update set
			period_id = source.period_id,
			verification_interval = source.verification_interval,
			verification_date = source.verification_date,
			failure_date = source.failure_date,
			sublist_id = source.sublist_id,
			account_id = source.account_id,
			close_type = source.close_type
	when not matched then
		insert (counter_id, period_id, verification_interval, verification_date, failure_date, sublist_id, account_id, close_type)
		values (source.counter_id, source.period_id, source.verification_interval, source.verification_date, source.failure_date, source.sublist_id, source.account_id, source.close_type);
	
	_reset_parametr = (select string_agg('
						"' || pl.short_name || '" = null,','') 
					from parametr.sublist ps
						inner join parametr.list pl on pl.id = ps.parametr_id
					where pl.is_calculation = true);

	_reset_parametr = (select string_agg('
						"' || "name" || '" = null,','')
					from parametr.input_sublist);

	_reset_parametr = (select string_agg(coalesce('
							"' || short_name || '" = ' || 
								case 
									when type_id = 3 then case when default_value = null then 'null' else '' || default_value || '' end
									when type_id = 4 then case when default_value = null then 'null' else '' || default_value || '' end
									else coalesce(default_value, 'null')
								end || ',',''),'')
						from parametr.list
						where is_reset = true);

	if (coalesce(_reset_parametr, '') != '')
		then
			begin
				_reset_parametr = (select 'update calculation.parametr_transporate set ' || substring(_reset_parametr, 1, length(_reset_parametr) - 1));
				execute(_reset_parametr);
			end;
	end if;

	_update_entity = (select string_agg('
						insert into ' || pc.p_table || ' (parametr_id, ' || pc.p_table_id || ', value, date_begin) 
						select ' || pl.id || ', id, ' || 
							case 
								when coalesce(pl.default_value, '') = '' 
								then 'null' 
								else pl.default_value 
							end || ', ''' || _date_begin || ''' from ' || pc.parent_table  || case when pl.catalog_id != 1 then '' else ' where parent_id is null' end,';')
						from parametr.list pl
							inner join parametr.catalog pc on pc.id = pl.catalog_id
						where is_reset = true and not exists(select * from parametr.sublist s where s.parametr_id = pl.id));

	if (coalesce(_update_entity, '') <> '') 
		then
			execute(_update_entity);
	end if;

	insert into counter.flow (counter_id, period_id, prev_value, value, c_value, flow_type_id, sublist_id, rate, prev_date, date)
	select counter_id, _period_is_working_id, coalesce(value, prev_value), null, 0.0, 0, cf.sublist_id, cf.rate, coalesce(date, prev_date), null
	from counter.flow cf
		inner join counter.list cl on cf.counter_id = cl.id
	where period_id = _period_id and coalesce(cl.date_end, _date_end) >= _date_end;

	_reset_column_tarif = (select string_agg('
								"' || column_name || '" = null,' ,'')
							from information_schema.columns
							where lower(table_name) = 'tarif' and lower(table_schema) = 'calculation'
								and lower(is_nullable) = 'yes');

	_reset_column_normativ = (select string_agg('
								"' || column_name || '" = null,','') 
							from information_schema.columns
							where lower(table_name) = 'normativ' and lower(table_schema) = 'calculation'
								and lower(is_nullable) = 'yes');

	_reset_column_volume = (select string_agg('
								"' || column_name || '" = null,','') 
							from information_schema.columns
							where lower(table_name) = 'volume' and lower(table_schema) = 'calculation'
								and lower(is_nullable) = 'yes');

	_reset_column_sum_volume = (select string_agg('
									"' || column_name || '" = null,' ,'')
								from information_schema.columns
								where lower(table_name) = 'sum_volume' and lower(table_schema) = 'calculation'
									and lower(is_nullable) = 'yes');

	_reset_column_tarif = substring(_reset_column_tarif, 1, length(_reset_column_tarif) - 1);
	_reset_column_normativ = substring(_reset_column_normativ, 1, length(_reset_column_normativ) - 1);
	_reset_column_volume = substring(_reset_column_volume, 1, length(_reset_column_volume) - 1);
	_reset_column_sum_volume = substring(_reset_column_sum_volume, 1, length(_reset_column_sum_volume) - 1);

	_sql = '
			update calculation.tarif set ' || _reset_column_tarif || ';
			update calculation.normativ set ' || _reset_column_normativ || ';
			update calculation.volume set ' || _reset_column_volume || ';
			update calculation.sum_volume set ' || _reset_column_sum_volume||';';

	execute(_sql);

--------------------------------------------------------------------------------------------------------------------------------------------------------


	if exists (select 1
			   from pg_proc pg
					inner join pg_namespace ns on ns."oid" = pg.pronamespace 
				where lower(proname) = 'custom_tool' and lower(ns.nspname) = 'calculation') 
		then 
			begin
				call calculation.custom_tool (_odn, _session_id, _account);
				return;
			end;
	end if;
	
	if not exists(select * from jsonb_populate_recordset(null::account.list, _account) a limit 1) 
		then
			begin
				raise exception 'Остутствуют лицевые счета для расчета. Если вы применяли фильтр по типу помещений, убедитесь, что в выбранных домах имеются помещения с выбранным типом.';
				return;
			end;
	end if; 

	select id, date_begin, date_end 
	into _period_id1, _date_begin1, _date_end1 
	from "period".list 
	where is_working = true;

	create temp table _calc_sublist (sublist_id int);

	if (_odn = false)
		then 
			begin
				insert into _calc_sublist (sublist_id)
				select id 
				from utility.sublist
				where is_odn = false and type != 4 and id not in (6, 7);
			end;	
		else 
			begin
				insert into _calc_sublist (sublist_id)
				select id 
				from utility.sublist
				where id not in (6, 7);
			end;
	end if;

	delete 
	from calculation.account_sublist as ca
	using _calc_sublist as s 
		,jsonb_populate_recordset(null::account.list, _account) as  a 
	where s.sublist_id = ca.sublist_id and a.account_id = ca.account_parent_id;
	
	alter table calculation.account_sublist disable trigger insert_account_sublist_edit;
	alter table calculation.account_sublist disable trigger update_account_sublist_edit;

	if exists(select * from utility.contragent_group)
		then
			insert into calculation.account_sublist (account_id, account_parent_id, house_id, sublist_id, value, "date")
			select aa.id, aa.parent_id, aa.house_id, uc.sublist_id, true, _date_begin1
			from utility.contragent_group_sublist uc
				inner join adress.account aa on aa.group_id = uc.group_id and aa.house_id = uc.house_id
				inner join jsonb_populate_recordset(null::account.list, _account) as a on a.account_id = aa.parent_id
				inner join _calc_sublist s on s.sublist_id = uc.sublist_id
			where _date_begin1 between uc.date_begin and coalesce(uc.date_end, _date_end1) 
									or uc.date_begin between _date_begin1 and coalesce(uc.date_end, _date_end1)
			group by  aa.id, aa.parent_id, aa.house_id, uc.sublist_id;
		else 
			insert into calculation.account_sublist (account_id, account_parent_id, house_id, sublist_id, value, "date")
			select aa.id, aa.parent_id, aa.house_id, us.sublist_id, true, _date_begin1
			from utility.sublist_provider us
				inner join adress.account aa on aa.house_id = us.house_id
				inner join jsonb_populate_recordset(null::account.list, _account) as a on a.account_id = aa.parent_id
				inner join _calc_sublist s on s.sublist_id = us.sublist_id
			where _date_begin1 between us.date_begin  and coalesce(us.date_end, _date_end1)	
									or us.date_begin between _date_begin1 and coalesce(us.date_end, _date_end1)
			group by aa.id, aa.parent_id, aa.house_id, us.sublist_id;
	end if;

	alter table calculation.account_sublist enable trigger insert_account_sublist_edit;
	alter table calculation.account_sublist enable trigger update_account_sublist_edit;

	_parametr_id = (select id from parametr.list  where lower(short_name) = 'code_region');
	_parametr_reg_id = (select id from parametr.list where lower(short_name) = 't_reg');

	_is_input = (select (case 
							when array_to_string(xpath('Root/UI/IsUseInput/text()', p.xml_data)::text[] , '') = '' 
							then false 
							else array_to_string(xpath('Root/UI/IsUseInput/text()', p.xml_data)::text[], '')::bool 
						end)
				 from special.parametr p);				

------ рачет кол-ва зарегистрированных

	with cte as 
	(
		select ca.account_id, count(*) as cnt 
		from contragent.account ca
			inner join jsonb_populate_recordset(null::account.list, _account) as a on a.account_id = ca.account_id
			inner join contragent.parametr cp on cp.contragent_account_id = ca.id
			inner join parametr.book pb on pb.id = cp.book_id
		where coalesce(reg_date_end, _date_begin1) >= _date_begin1 and pb."number"::int > 0 and cp.parametr_id = _parametr_reg_id
		group by ca.account_id
	)
		
	update calculation.parametr_transporate as cpp
		set col_reg = coalesce(c.cnt, 0)
	from jsonb_populate_recordset(null::account.list, _account) as a 
		left join cte c on c.account_id = a.account_id
	where a.account_id = cpp.account_id and coalesce(cpp.col_reg, 0) <> coalesce(cnt, 0);

	_houses = (select jsonb_agg(jsonb_build_object('house_id', house_id))
			   from (select distinct aa.house_id
					 from adress.account aa
					 	join jsonb_populate_recordset(null::account.list, _account) as a on a.account_id = aa.id
					 ) as f
			  );

--расчет параметров ввода
	if (_is_input = true) 
		then
			call "input".cp_transporate ();
	end if;
	--расчет параметров
	call calculation.cp_transporate (_houses);
	call calculation.contragent (_account);

--!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
--call calculation.create_calc (_odn, (case when _is_input = true then true else false end), _account);


















select pl.id, pl.date_begin, pl.date_end 
	into  _period_id2, _date_begin2, _date_end2 
	from period.List pl 
	where is_working = true;

	
	   with cte as 
	   (
		   select 
				',' || string_agg('
				' || pl.short_name, ', ') as calc_column			
				,', ' || string_agg(pl.short_name || ' numeric(' || cast(pl.len as varchar(3)) || ', ' || cast(pl."precision" as varchar(3)) || ')', ', ') as calc_column_with_type
				,string_agg('
				' || pl.short_name || ' = new_' || pl.short_name, ', ') || ',' as input_calc_parametr			
				,string_agg(substring(pf.formula, position('%[0-9]%' in pf.formula), 2), ',' ) || ',' as sublist_filter			
				,string_agg('
				,sum(' || pf.formula || ') over (partition by cp.house_id' 
						|| case 
								when _is_input = true and il.sublist_id is not null 
								then ', ' || quote_ident('i_' || cast(us.short_name as varchar(10))) 
								else '' 
							end 
						|| ' order by cp.house_id' 
						|| case 
								when _is_input = true and il.sublist_id is not null 
								then ', ' || quote_ident('i_' || cast(us.short_name as varchar(10))) 
								else '' 
							end 
						|| ') as "new_' || pl.short_name || '"
				,cs.' || pl.short_name || '', ' ') as calc_formula
			from parametr.list pl
				inner join parametr.formula pf on pf.parametr_id = pl.id
				left join utility.sublist us on us.id = pf.sublist_id
				left join (
								select distinct sublist_id
								from "input".list
							) il on il.sublist_id = us.id
			where pl.catalog_id = 9 and pf.tag_id = 2 and pf.date_end is null
		)		

		select ct.calc_column, ct.calc_column_with_type, ct.input_calc_parametr, ct.sublist_filter, ct.calc_formula 
		into _calc_column, _calc_column_with_type, _input_calc_parametr, _sublist_filter, _calc_formula
		from cte ct;

		_sublist_filter 	 := left(_sublist_filter, length(_sublist_filter) - 1);
		_input_calc_parametr := left(_input_calc_parametr, length(_input_calc_parametr) - 1);	
	
		with cte as 
		(
			select 
			string_agg(column_name || ' ' || case when data_type = 'numeric' then data_type || '(' || cast(numeric_precision as varchar(3)) || ', ' || cast(numeric_scale as varchar(3)) 
			|| ')' else data_type end, ', ' order by ordinal_position) as colt_winth_type
			,string_agg(column_name, ',') as colt
			from information_schema.columns 
			where lower(table_schema) = 'calculation' and lower(table_name) = 'parametr_transporate'
		) 

		select ct.colt_winth_type,ct.colt
		into _colt_winth_type,_colt
		from cte ct; 
	
		with cte as 
		(	
			select 
			 string_agg(case when us.is_odn = false and fr."type" = 1 then chr(10) || quote_ident (
				't_' || us.short_name) || ' = ' || fr.formula || ',' else '' end, '') as tarif,
			 string_agg(case when us.is_odn = true and fr."type" = 1 then chr(10) || quote_ident (
				't_' || us.short_name) || ' = ' || fr.formula || ',' else '' end, '') as tarif_odn,
			 string_agg(case when fr."type" = 1 then  '
				when ca.sublist_id = ' || cast(us.id as varchar(10)) || ' then coalesce(' || quote_ident  ('t_' || us.short_name) || ', 0.0)' else '' end, '') as tarif_balance,
			 string_agg(case when fr."type" = 2 then coalesce( 
				quote_ident ('n_' || us.short_name) || ' = ' || fr.formula, '') || ','  else '' end, '') as normativ,
			 string_agg(case when fr."type" = 2 then  '
				when ca.sublist_id = ' || cast(us.id as varchar(10)) || ' then coalesce(' || chr(10) || quote_ident ('n_' || us.short_name) || ', 0.0)' else '' end, '') as normativ_balance,
			 string_agg(case when fr."type" = 2 then case when us."type" = 1 or ut.parent_id = 1 then '
				when ca.sublist_id = ' || cast(us.id as varchar(10)) || ' then coalesce(' || chr(10) || quote_ident ('r_' || us.short_name) || ', 0.0)' else '' end else '' end, '') as rate_balance,
			 string_agg(case when us.is_odn = false and fr."type" = 3 then chr(10) || quote_ident (
				'v_' || us.short_name) || ' = ' || formula||','  else '' end, '') as volume,
			 string_agg(case when us.is_odn = true and fr."type" = 3 then  chr(10) || quote_ident (
				'v_' || us.short_name) || ' = ' || formula||','  else '' end, '') as volume_odn,
			 string_agg(case when fr."type" = 3 then  '
				when ca.sublist_id = ' || cast(us.id as varchar(10)) || ' then coalesce(' || quote_ident ('v_' || us.short_name) || ', 0.0)' else '' end, '') as volume_balance 
			from utility.sublist us 
				inner join utility."type" ut on ut.id = us."type"
				inner join utility.formula_result fr on fr.sublist_id = us.id
			where fr.period_id = _period_id2 and us.is_on = true
		)
		
		select ct.tarif, ct.tarif_odn, ct.tarif_balance, ct.normativ, ct.normativ_balance, ct.rate_balance, ct.volume, ct.volume_odn, ct.volume_balance
		into _tarif, _tarif_odn, _tarif_balance, _normativ, _normativ_balance, _rate_balance, _volume, _volume_odn, _volume_balance
		from cte ct;
	
		create temp table _territory_id (territory_id int);
		create temp table _sublust_id (sublist_id int);
	   
		insert into _territory_id
		select territory_id
		from adress.house
		group by territory_id;

		insert into _sublust_id
		select sublist_id
		from normativ.list
		group by sublist_id;			
	
		with terr as 
		(
			select string_agg(' when territory_id = ' || cast(nl.territory_id as varchar(5)) || ' then ' ||  cast(nl.rate as varchar(10)), ' ') as tt, sublist_id 
			from normativ.list nl
				inner join _territory_id t on t.territory_id = nl.territory_id
			where nl.date_end is null  
			group by nl.rate, nl.territory_id, nl.sublist_id
		)
		,cte as 
		(
			select string_agg(coalesce(chr(10) || quote_ident  ('r_' || us.short_name) 
					|| ' = case ' || tr.tt
					|| ' end,', ''), '') as normativ
			from utility.sublist us
				inner join _sublust_id s on s.sublist_id = us.id
				inner join terr tr on tr.sublist_id = us.id
		) 
			
		select  normativ 
		into _normativ 
		from cte ct;

		drop table _territory_id;
		drop table _sublust_id;

		_tarif_odn 		 = case when _tarif_odn = '' then '' else substring(_tarif_odn, 1, length(_tarif_odn) - 1) end;
		_volume_odn 	 = case when _volume_odn = '' then '' else substring(_volume_odn, 1, length(_volume_odn) - 1) end;
		_normativ 		 = substring(_normativ, 1, length(_normativ) - 1);
		_tarif 			 = substring(_tarif, 1, length(_tarif) - 1);
		_volume 		 = substring(_volume, 1, length(_volume) - 1);
		_colt_winth_type = substring(_colt_winth_type, 1, length(_colt_winth_type) - 1);
		_colt			 = substring(_colt, 1, length(_colt) - 1);

		_normativ_balance = case  when _normativ_balance = '' then '0.0' else '
		, case' || _normativ_balance || ' else 0.0 
		end as normariv ' end;
	
		_tarif_balance = case when _tarif_balance = '' then '0.0' else '
		, case' || _tarif_balance || ' else 0.0 
		end as tarif ' end;
	
		_volume_balance = case when _volume_balance = '' then '0.0' else '
		, case' || _volume_balance || ' else 0.0 
		end as volume' end;
	
		_rate_balance = case when _rate_balance = '' then '0.0' else '
		,case' || _rate_balance || ' else 0.0 
		end as rate ' end;		

		drop procedure if exists calculation.calc;

	_sql1 = '
create or replace procedure calculation.calc (_account jsonb)
language plpgsql
AS $calculation_calc$
begin
	
	drop table if exists  _house_list;
	drop table if exists _account_list;
	drop table if exists _temp_balance;
	drop table if exists _calc_sublist;
	drop table if exists _flow_print;

	create table _house_list (house_id int);
	create table _account_list (account_id int);
	create table _temp_balance (
								house_id int not null, 
								flat_id int not null, 
								account_id int not null, 
								sublist_id int not null, 
								account_parent_id int not null, 
								period_id int not null, 
								tarif numeric(9,2) not null, 
								volume numeric(14,8) not null, 
								normativ numeric(9,5) not null, 
								rate numeric(9,2), flow bool
								);
	ALTER TABLE ONLY _temp_balance 
    	ADD CONSTRAINT pk_temp_balance PRIMARY KEY (account_id, sublist_id);
	create table _calc_sublist (sublist_id int);
	create table _flow_print (house_id int, sublist_id int, flow_print bool);
	
	insert into _account_list
	select a.account_id
	from jsonb_populate_recordset(null::account.list, _account) a;

	insert into _house_list(house_id)
	select aa.house_id 
	from adress.account aa
		inner join _account_list a on a.account_id = aa.id
	group by house_id;

	insert into _flow_print 
	select aa.house_id, cf.sublist_id, true as flow_print
		from counter.flow cf
		inner join counter.list cl on cl.id = cf.counter_id and cl.is_calculation = true
		inner join period.list pl on pl.id = cf.period_id and pl.is_working = true
		inner join counter.account ca on cf.counter_id = ca.counter_id
		inner join adress.account aa on aa.parent_id = ca.account_id
		inner join _account_list a on a.account_id = ca.account_id
		group by aa.house_id, cf.sublist_id
	union 
	select ah.id as house_id, cf.sublist_id, true as flow_print
		from counter.flow cf
		inner join counter.list cl on cl.id = cf.counter_id and cl.is_calculation = true
		inner join period.list pl on pl.id = cf.period_id and pl.is_working = true
		inner join counter.house ch on cf.counter_id = ch.counter_id
		inner join adress.house ah on ah.id = ch.house_id
		inner join _house_list h on h.house_id = ch.house_id
		group by ah.id, cf.sublist_id
	union
	select ah.id, usp.sublist_id, true as flow_print
		from adress.house ah
		inner join _house_list h on h.house_id = ah.id 
		inner join utility.sublist_provider usp on usp.house_id = ah.id
		inner join utility.sublist us on us.id = usp.sublist_id
		inner join period.list pl on pl.is_working = true
		where us.is_counter = false and us.type = 1 and usp.date_begin <= pl.date_end and coalesce(usp.date_end, pl.date_end) >= pl.date_end 
		group by ah.id, usp.sublist_id;
	
	update calculation.normativ cn set
		' || _normativ || '
	from calculation.parametr_transporate cp' || case when _odn = true then '
		inner join _house_list h on h.house_id = cp.house_id' else '
		inner join _account_list a on a.account_id = cp.account_id' end || '
	where cn.account_id = cp.account_id and cp.is_closed = 1;

	update calculation.volume cv set
		' || _volume || '
	from calculation.parametr_transporate cp' || case when _odn = true then '
		inner join _house_list h on h.house_id = cp.house_id' else '
		inner join _account_list a on a.account_id = cp.account_id' end || '
		inner join calculation.normativ cn on cn.account_id = cp.account_id
	where cp.is_closed = 1;	
		
	with cte as (
		select 
			cv.house_id 
			,cv.account_id' || _calc_formula || ' 
		from calculation.parametr_transporate cp
			inner join calculation.sum_volume cs on cp.account_id = cs.account_id
			inner join calculation.volume cv on cp.account_id = cv.account_id
			inner join _house_list h on h.house_id = cp.house_id';

--	if (_is_input = true) 
--	then 
--		begin
--			
--		_sql1 = _sql1 || '
--			left join (
--				select 
--					account_id';
--
--		_sql1 = _sql1 || (select string_agg('
--						,max(case when sublist_id = ' || cast(us.id as varchar(10)) || ' then input_id end) as i_' || us.short_name, '') as t
