--		' || case when _tarif_odn != '' and _tarif != '' then ',' else '' end || replace(_tarif_odn, 'house_id', 'cp.house_id') || '
--	from calculation.parametr_transporate cp' || case when _odn = true then '
--		inner join _house_list h on h.house_id = cp.house_id' else '
--		inner join _account_list a on a.account_id = cp.account_id' end || '
--		inner join calculation.normativ cn on cn.account_id = cp.account_id
--		inner join calculation.volume cv on cv.account_id = cp.account_id
--		inner join calculation.sum_volume c on c.account_id = cp.account_id
--	where ct.account_id = cp.account_id and cp.is_closed = 1;
--
--	insert into _temp_balance
--	select 
--		cv.house_id
--		,cv.flat_id
--		,ca.account_id
--		,ca.sublist_id
--		,cv.account_id
--		,' || cast(_period_id2 as varchar(10)) || ' as period_id' || _tarif_balance || _volume_balance || _normativ_balance || _rate_balance || '
--		,fp.flow_print
--	from calculation.normativ cn
--		inner join _account_list a on a.account_id = cn.account_id
--		inner join calculation.volume cv on cv.account_id = cn.account_id
--		inner join calculation.tarif ct on ct.account_id = cn.account_id
--		inner join calculation.account_sublist ca on ca.account_parent_id = cn.account_id
--		inner join utility.sublist us on us.id = ca.sublist_id
--		left join _flow_print fp on fp.house_id = cv.house_id and fp.sublist_id = ca.sublist_id 
--	where us.is_on = true and us.id not in (6,7)' || case when _odn = false then ' and us.id not in (11,12,13,14)' else '' end ||';
--	' || case when _odn = false then '
--	insert into _calc_sublist (sublist_id)
--	select id from utility.sublist
--	where is_odn = false and type != 4 and id not in (6, 7)'
--	else '
--	
--	insert into _calc_sublist (sublist_id)
--	select id from utility.sublist
--	where id not in (6, 7)' end || ';' || '
--
--	update payment.balance p
--		set tarif = 0.0
--			,volume = 0.0
--			,current_calculate = 0.0
--	from payment.balance pb
--		inner join _calc_sublist s on s.sublist_id = pb.sublist_id
--		inner join _account_list a on a.account_id = pb.account_parent_id
--		inner join period.list pl on pl.id = pb.period_id
--	where p = pb and pl.is_working = true and pb.sublist_id not in (6,7);
--
--
--	merge into payment.balance as targets
--		using(select * from _temp_balance)
--		as sources(house_id, flat_id, account_id, sublist_id, account_parent_id, period_id, tarif, volume, normativ, rate, flow_print)
--		on(targets.account_id = sources.account_id and targets.sublist_id = sources.sublist_id and targets.period_id = sources.period_id)
--		when matched then
--			update set
--				tarif = sources.tarif,
--				volume = sources.volume,
--				normativ = sources.normativ,
--				rate_normativ = sources.rate,
--				current_calculate = sources.tarif * sources.volume
--		when not matched and (sources.tarif * sources.volume != 0.0 or sources.flow_print is not null) then
--			insert(house_id, flat_id, account_id, period_id, sublist_id, tarif, normativ, volume, in_balance, current_calculate, recalculate, rate_normativ, account_parent_id, pay)
--			values(sources.house_id, sources.flat_id, sources.account_id, sources.period_id, sources.sublist_id, sources.tarif, sources.normativ, sources.volume, 0.0, sources.tarif * sources.volume, 0.0, rate, sources.account_parent_id, 0.0);
--
--
--
--
--	drop table if exists _house_list;
--	drop table if exists _account_list;
--	drop table if exists _temp_balance;
--	drop table if exists _calc_sublist;
--	drop table if exists _flow_print;
--
