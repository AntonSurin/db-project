	insert into "1c".pko ("period_id","house_id","sublist_id","organization_guid","organization_name","customers_guid","customers_name","contract_guid","contract_name","cash_guid","cash_name","cash_flow_guid","cash_flow_name","cash_customer_guid","cash_customer_name","debt_guid","debt_name","type_pko","rs_guid","rs_name","is_active",nomenclature, nomenclature_guid)
	select _period_is_working_id,"house_id","sublist_id","organization_guid","organization_name","customers_guid","customers_name","contract_guid","contract_name","cash_guid","cash_name","cash_flow_guid","cash_flow_name","cash_customer_guid","cash_customer_name","debt_guid","debt_name","type_pko","rs_guid","rs_name","is_active",nomenclature, nomenclature_guid
	from "1c".pko
	where period_id = _period_id;

	update utility.sublist_group_a_detail 
		set period_id = null
	where period_id < _period_is_working_id;

	drop table if exists _close_counter_id;		
		
