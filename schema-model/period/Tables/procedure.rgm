table "period"."procedure" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_procedure"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('period.procedure_id_seq'::regclass)
    }
    column "name" {
      type = character varying(200)
    }
    column "description" {
      type = character varying(200)
    }
  )
}

