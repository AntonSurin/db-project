table "period"."list" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_list"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('period.list_id_seq'::regclass)
    }
    column "month_id" {
      type = smallint
      null = NOT NULL
    }
    column "name_month" {
      type = character varying(8)
      null = NOT NULL
    }
    column "year" {
      type = integer
      null = NOT NULL
    }
    column "date_begin" {
      type = date
      null = NOT NULL
    }
    column "date_end" {
      type = date
      null = NOT NULL
    }
    column "day_in_month" {
      type = smallint
      null = NOT NULL
    }
    column "is_active" {
      type = boolean
      null = NOT NULL
    }
    column "is_working" {
      type = boolean
      null = NOT NULL
    }
    column "is_open" {
      type = boolean
      null = NOT NULL
    }
    column "date_open" {
      type = timestamp(3) without time zone
    }
    column "is_visible" {
      type = boolean
      null = NOT NULL
      default = true
    }
  )
}

