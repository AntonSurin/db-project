    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('bank.bank_exchange_to_batch_id_seq'::regclass)
    }
    column "batch_id" {
      type = integer
      null = NOT NULL
    }
    column "bank_exchange_document_id" {
      type = integer
      null = NOT NULL
    }
  )
}

foreignKey "bank"."bank_exchange_to_batch"."fk_bank_exchange_to_batch_batch" {
  columns = [
