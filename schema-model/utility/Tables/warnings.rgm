table "utility"."warnings" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_warnings"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('utility.warnings_id_seq'::regclass)
    }
    column "sublist_id" {
      type = integer
      null = NOT NULL
    }
    column "first_more" {
      type = numeric(13,5)
    }
    column "first_color" {
      type = integer
    }
    column "second_more" {
      type = numeric(13,5)
    }
    column "second_color" {
      type = integer
    }
    column "max_flow" {
      type = numeric(13,5)
    }
  )
}

foreignKey "utility"."warnings"."fk_warnings_sub_list" {
  columns = [
    "sublist_id"
  ]
  referencedTable = "utility"."sublist"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
}

