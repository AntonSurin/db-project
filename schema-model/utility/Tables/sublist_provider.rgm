table "utility"."sublist_provider" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_sub_list_provider"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('utility.sublist_provider_id_seq'::regclass)
    }
    column "sublist_id" {
      type = integer
      null = NOT NULL
    }
    column "provider_id" {
      type = integer
      null = NOT NULL
    }
    column "territory_id" {
      type = integer
      null = NOT NULL
    }
    column "house_id" {
      type = integer
      null = NOT NULL
    }
    column "date_begin" {
      type = date
      null = NOT NULL
    }
    column "date_end" {
      type = date
    }
  )
}

foreignKey "utility"."sublist_provider"."fk_sub_list_provider_house" {
  columns = [
