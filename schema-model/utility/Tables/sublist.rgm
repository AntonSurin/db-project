table "utility"."sublist" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_sub_list"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('utility.sublist_id_seq'::regclass)
    }
    column "list_id" {
      type = integer
      null = NOT NULL
    }
    column "gis_guid" {
      type = uuid
    }
    column "code" {
      type = character varying(20)
    }
    column "guid" {
      type = uuid
    }
    column "name" {
      type = character varying(100)
      null = NOT NULL
    }
    column "short_name" {
      type = character varying(20)
      null = NOT NULL
    }
    column "date_begin" {
      type = date
      null = NOT NULL
    }
    column "date_end" {
      type = date
    }
    column "is_counter" {
      type = boolean
      null = NOT NULL
      default = false
    }
    column "unit_id" {
      type = integer
    }
    column "is_odn" {
      type = boolean
      null = NOT NULL
      default = false
    }
    column "number" {
      type = integer
    }
    column "type" {
      type = smallint
      null = NOT NULL
      default = 0
    }
    column "is_day" {
      type = boolean
      null = NOT NULL
      default = false
    }
    column "is_kp" {
      type = boolean
    }
    column "service_guid" {
      type = uuid
      null = NOT NULL
      default = gen_random_uuid()
    }
    column "is_on" {
      type = boolean
      null = NOT NULL
      default = true
    }
    column "gis_type" {
      type = smallint
    }
    column "vat_type" {
      type = integer
    }
    column "agent_type" {
      type = smallint
      null = NOT NULL
      default = 0
    }
    column "parent_id" {
      type = integer
    }
  )
}

foreignKey "utility"."sublist"."fk_sub_list_list" {
  columns = [
    "list_id"
  ]
  referencedTable = "utility"."list"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
  onDelete = CASCADE
}

foreignKey "utility"."sublist"."fk_sub_list_unit" {
  columns = [
    "unit_id"
  ]
  referencedTable = "utility"."unit"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
}

foreignKey "utility"."sublist"."fk_sublist_sublist" {
  columns = [
    "parent_id"
  ]
  referencedTable = "utility"."sublist"
  referencedColumns = [
    "id"
  ]
}

