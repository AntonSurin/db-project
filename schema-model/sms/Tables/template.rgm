table "sms"."template" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_template"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('sms.template_id_seq'::regclass)
    }
    column "name" {
      type = character varying(50)
      null = NOT NULL
    }
    column "message" {
      type = character varying(340)
      null = NOT NULL
    }
    column "feedback_phone" {
      type = character varying(11)
    }
    column "is_call" {
      type = boolean
      null = NOT NULL
      default = false
    }
  )
}

