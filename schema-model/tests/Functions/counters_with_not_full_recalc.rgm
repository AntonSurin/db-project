function "tests"."counters_with_not_full_recalc(jsonb)" {
  text = """

declare 
	_period_id int;
begin

	_period_id = (select pl.id from "period".list pl where pl.is_working = true);

	return query
	select
		'wrn'::varchar(3) as severity,
		aa."name" as account_name
	from counter.flow cf
		inner join counter.account ca on ca.counter_id = cf.counter_id
		inner join adress.account aa on aa.id = ca.account_id
		left join lateral (
							select sum(f.flow) as sum_flow
							from counter.flow f
							where f.counter_id = cf.counter_id 
								and f.period_id >= (select min(cpa.period_id) from calculation.parametr_transporate_arch cpa where cpa.account_id = ca.account_id)
						) fo on true
	where cf.period_id = _period_id 
		and cf.c_value <> 0.0 
		and cf.c_value > fo.sum_flow 
		and (not exists(select ac.account_id from jsonb_populate_recordset(null::account.list, _account) as ac) or ca.account_id in (select a.account_id from jsonb_populate_recordset(null::account.list, _account) a));

end;
"""
  returnType = TABLE(severity character varying, account_name character varying)
  arguments = <
    {
      name = _account
      type = jsonb
      mode = IN
    }

  >
  language = plpgsql
  owner = postgres
  comment = """-
=============================================
 Author:			Поляков Павел
 Create date:		13.09.2017
 Modified date:	10.12.2020, Трофимов Б.И. - добавил фильтр по лс для автоматического запуска тестов
 Description:		Проверка на возможное не полное распределение корректировочного объема 
 =============================================
"""
}

