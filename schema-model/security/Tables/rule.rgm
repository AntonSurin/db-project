table "security"."rule" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_rule"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('security.rule_id_seq'::regclass)
    }
    column "name" {
      type = character varying(100)
      null = NOT NULL
    }
    column "short_name" {
      type = character varying(50)
      null = NOT NULL
    }
  )
}

