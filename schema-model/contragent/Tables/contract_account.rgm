table "contragent"."contract_account" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_contract_account"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('contragent.contract_account_id_seq'::regclass)
    }
    column "account_id" {
      type = integer
      null = NOT NULL
    }
    column "contract_id" {
      type = integer
      null = NOT NULL
    }
    column "date_begin" {
      type = date
      null = NOT NULL
    }
    column "date_end" {
      type = date
    }
  )
}

foreignKey "contragent"."contract_account"."fk_contract_account_account" {
  columns = [
    "account_id"
  ]
  referencedTable = "adress"."account"
  referencedColumns = [
    "id"
  ]
  onDelete = CASCADE
}

foreignKey "contragent"."contract_account"."fk_contract_account_contract" {
  columns = [
    "contract_id"
  ]
  referencedTable = "contragent"."contract"
  referencedColumns = [
    "id"
  ]
  onDelete = CASCADE
}

