table "portal"."upload" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_upload_1"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('portal.upload_id_seq'::regclass)
    }
    column "event_name" {
      type = character varying(50)
      null = NOT NULL
    }
    column "data" {
      type = text
      null = NOT NULL
    }
    column "is_processed" {
      type = boolean
      null = NOT NULL
      default = false
    }
    column "stack_trace" {
      type = text
    }
  )
}

