table "payment"."detal" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_detal"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('payment.detal_id_seq'::regclass)
    }
    column "payment_id" {
      type = integer
      null = NOT NULL
    }
    column "account_id" {
      type = integer
      null = NOT NULL
    }
    column "sublist_id" {
      type = integer
      null = NOT NULL
    }
    column "period_id" {
      type = integer
      null = NOT NULL
    }
    column "sum" {
      type = numeric(9,2)
      null = NOT NULL
      default = 0.0
    }
    column "account_parent_id" {
      type = integer
      null = NOT NULL
    }
    column "is_manual" {
      type = boolean
      null = NOT NULL
      default = false
    }
  )
}

foreignKey "payment"."detal"."fk_detal_account" {
  columns = [
    "account_id"
  ]
  referencedTable = "adress"."account"
  referencedColumns = [
    "id"
  ]
}

foreignKey "payment"."detal"."fk_detal_detal_sub_util" {
  columns = [
    "sublist_id"
  ]
  referencedTable = "utility"."sublist"
  referencedColumns = [
    "id"
  ]
}

foreignKey "payment"."detal"."fk_detal_list" {
  columns = [
    "period_id"
  ]
  referencedTable = "period"."list"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
}

foreignKey "payment"."detal"."fk_detal_list_payment" {
  columns = [
    "payment_id"
  ]
  referencedTable = "payment"."list"
  referencedColumns = [
    "id"
  ]
  onDelete = CASCADE
}

