table "payment"."document_detail" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_payment_document_detail"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('payment.document_detail_id_seq'::regclass)
    }
    column "payment_document_id" {
      type = integer
      null = NOT NULL
    }
    column "sublist_id" {
      type = integer
      null = NOT NULL
    }
    column "sum" {
      type = numeric(9,2)
      null = NOT NULL
    }
    column "account_id" {
      type = integer
      null = NOT NULL
    }
  )
}

foreignKey "payment"."document_detail"."fk_document_detail_adress_account" {
  columns = [
    "account_id"
  ]
  referencedTable = "adress"."account"
  referencedColumns = [
    "id"
  ]
}

foreignKey "payment"."document_detail"."fk_document_detail_document" {
  columns = [
    "payment_document_id"
  ]
  referencedTable = "payment"."document"
  referencedColumns = [
    "id"
  ]
  onDelete = CASCADE
}

foreignKey "payment"."document_detail"."fk_document_detail_utility_sublist" {
  columns = [
    "sublist_id"
  ]
  referencedTable = "utility"."sublist"
  referencedColumns = [
    "id"
  ]
}

index "payment"."document_detail_pay_doc_detail_pay_doc_id" {
  table = "payment"."document_detail"
  type = btree
  columns = <
    {
      definition = payment_document_id
    }

  >
  isUnique = False
  includeColumns = [
    id
    sublist_id
    sum
  ]
}

