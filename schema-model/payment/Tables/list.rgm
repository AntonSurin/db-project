foreignKey "payment"."list"."fk_payment_list_upload_number" {
  columns = [
    "upload_number"
  ]
  referencedTable = "payment"."upload_info"
  referencedColumns = [
    "id"
  ]
}

index "payment"."list_ak_service_guid" {
  table = "payment"."list"
  type = btree
  columns = <
    {
      definition = service_guid
    }

  >
  isUnique = True
}

