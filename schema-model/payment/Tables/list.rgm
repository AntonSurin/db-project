table "payment"."list" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_list"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('payment.list_id_seq'::regclass)
    }
    column "batch_id" {
      type = integer
      null = NOT NULL
    }
    column "date" {
      type = date
      null = NOT NULL
    }
    column "sum" {
      type = numeric(15,2)
      null = NOT NULL
    }
    column "account_id" {
      type = integer
      null = NOT NULL
    }
    column "type_id" {
      type = smallint
      null = NOT NULL
      default = 0
    }
    column "is_print_check" {
      type = boolean
      default = false
    }
    column "payment_type" {
      type = smallint
      default = 0
    }
    column "period_id" {
      type = integer
      null = NOT NULL
    }
    column "payment_period_id" {
      type = integer
    }
    column "unique_number" {
      type = character varying(32)
    }
    column "guid" {
      type = uuid
    }
    column "status" {
      type = smallint
      default = 0
    }
    column "check_type" {
      type = smallint
    }
    column "service_guid" {
      type = uuid
      default = gen_random_uuid()
    }
    column "check_status" {
      type = smallint
      null = NOT NULL
      default = 0
    }
    column "upload_number" {
      type = integer
    }
    column "print_date" {
      type = timestamp(6) without time zone
    }
    column "registred_date" {
      type = timestamp(6) without time zone
    }
    column "cashless_payment" {
      type = boolean
      null = NOT NULL
      default = false
    }
    column "created_at" {
      type = timestamp(6) without time zone
    }
    column "session_id" {
      type = integer
    }
    column "return_basis_id" {
      type = integer
    }
  )
}

foreignKey "payment"."list"."fk_list_account" {
  columns = [
    "account_id"
  ]
  referencedTable = "adress"."account"
  referencedColumns = [
    "id"
  ]
}

