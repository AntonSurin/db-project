view "payment"."pay_for_1c" {
  text = """-
SELECT oll.inn AS organization_inn,
    pb.date AS batch_date,
    pb.id AS batch_id,
    ai.account_name,
    pl.date AS payment_date,
    b.name AS batch_from_name,
    oc.rs,
    us.name AS sublist_name,
    us.id AS sublist_id,
    pd.sum AS detail_sum,
        CASE
            WHEN ((oc.rs)::text = '00000000000000000000'::text) THEN 1
            ELSE 0
        END AS rs_type,
    pl.id AS payment_id,
    COALESCE(br.fee, (0)::numeric) AS payment_comiss,
        CASE
            WHEN (pc.contract_id IS NOT NULL) THEN
            CASE
                WHEN (TRIM(BOTH FROM pc.inn) = ''::text) THEN NULL::text
                ELSE TRIM(BOTH FROM pc.inn)
            END
            ELSE NULL::text
        END AS contract_inn,
    ('д-'::text || ai.house_id) AS house_id,
    pc.contract_id,
    pl.type_id AS payment_type,
        CASE
            WHEN ((b.number)::smallint = 19) THEN 1
            WHEN ((b.number)::smallint = 5) THEN 2
            WHEN ((b.number)::smallint = 99) THEN 3
            ELSE 0
        END AS adjustment_type,
    pl.check_type,
    pl.cashless_payment
   FROM ((((((((((payment.batch pb
     JOIN payment.list pl ON ((pl.batch_id = pb.id)))
     JOIN payment.detal pd ON ((pd.payment_id = pl.id)))
     JOIN adress.info ai ON ((ai.account_id = pl.account_id)))
     JOIN organization.list ol ON ((ol.id = ai.organization_id)))
     JOIN organization.counting oc ON ((oc.id = pb.counting_id)))
     JOIN utility.sublist us ON ((us.id = pd.sublist_id)))
     JOIN parametr.book b ON ((b.id = pb.bank_id)))
     JOIN organization.list oll ON ((oll.id = oc.list_id)))
     LEFT JOIN bank.registry_payment br ON ((br.payment_id = pl.id)))
     LEFT JOIN LATERAL ( SELECT cl.inn,
            c.id AS contract_id,
            cl.surname,
            cl.name,
            cl.middlename,
            cl.type,
            cl.full_name,
            ca.id AS person_id
           FROM ((((contragent.account ca
             JOIN adress.account aa ON ((aa.id = ca.account_id)))
             JOIN contragent.owner_documents od ON ((od.contragent_account_id = ca.id)))
             JOIN contragent.list cl ON ((cl.id = ca.contragent_id)))
             LEFT JOIN LATERAL ( SELECT cc.id
                   FROM (contragent.contract cc
                     JOIN contragent.contract_account ac ON ((ac.contract_id = cc.id)))
                  WHERE ((ac.account_id = ca.account_id) AND (cc.date_end IS NULL))) c ON (true))
          WHERE ((ca.is_responsible = true) AND (od.date_end IS NULL) AND (ca.account_id = ai.account_id))
          ORDER BY cl.id
         LIMIT 1) pc ON (true));
"""
  kind = MATERIALIZED
  owner = postgres
  comment = ****** Object:  View [Payment].[PayFor1C]    Script Date: 11.10.2022 16:02:40 ******
  columns = (
    column "organization_inn" {
      type = character varying(12)
    }
    column "batch_date" {
      type = date
    }
    column "batch_id" {
      type = integer
    }
    column "account_name" {
      type = character varying(12)
    }
    column "payment_date" {
      type = date
    }
    column "batch_from_name" {
      type = character varying(100)
    }
    column "rs" {
      type = character varying(20)
    }
    column "sublist_name" {
      type = character varying(100)
    }
    column "sublist_id" {
      type = integer
    }
    column "detail_sum" {
      type = numeric(9,2)
    }
    column "rs_type" {
      type = integer
    }
    column "payment_id" {
      type = integer
    }
    column "payment_comiss" {
      type = numeric
    }
    column "contract_inn" {
      type = text
    }
    column "house_id" {
      type = text
    }
    column "contract_id" {
      type = integer
    }
    column "payment_type" {
      type = smallint
    }
    column "adjustment_type" {
      type = integer
    }
    column "check_type" {
      type = smallint
    }
    column "cashless_payment" {
      type = boolean
    }
  )
}

