table "parametr"."account" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_p_account"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('parametr.account_id_seq'::regclass)
    }
    column "account_id" {
      type = integer
      null = NOT NULL
    }
    column "parametr_id" {
      type = integer
      null = NOT NULL
    }
    column "value" {
      type = character varying(200)
    }
    column "date_begin" {
      type = date
      null = NOT NULL
    }
    column "date_end" {
      type = date
    }
  )
}

foreignKey "parametr"."account"."fk_p_account_account" {
  columns = [
    "account_id"
  ]
  referencedTable = "adress"."account"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
  onDelete = CASCADE
}

foreignKey "parametr"."account"."fk_p_account_pl_account" {
  columns = [
    "parametr_id"
  ]
  referencedTable = "parametr"."pl_account"
  referencedColumns = [
    "parametr_id"
  ]
  onUpdate = CASCADE
  onDelete = CASCADE
}

