table "parametr"."type" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_type"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('parametr.type_id_seq'::regclass)
    }
    column "name" {
      type = character varying(100)
      null = NOT NULL
    }
    column "system_type" {
      type = character varying(50)
    }
  )
}

