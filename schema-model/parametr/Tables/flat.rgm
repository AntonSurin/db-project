table "parametr"."flat" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "pk_p_apartment"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('parametr.flat_id_seq'::regclass)
    }
    column "flat_id" {
      type = integer
      null = NOT NULL
    }
    column "parametr_id" {
      type = integer
      null = NOT NULL
    }
    column "value" {
      type = character varying(200)
    }
    column "date_begin" {
      type = date
    }
    column "date_end" {
      type = date
    }
  )
}

foreignKey "parametr"."flat"."fk_p_apartment_apartment" {
  columns = [
    "flat_id"
  ]
  referencedTable = "adress"."flat"
  referencedColumns = [
    "id"
  ]
  onUpdate = CASCADE
  onDelete = CASCADE
}

foreignKey "parametr"."flat"."fk_p_apartment_pl_apartment" {
  columns = [
    "parametr_id"
  ]
  referencedTable = "parametr"."pl_flat"
  referencedColumns = [
    "parametr_id"
  ]
  onUpdate = CASCADE
  onDelete = CASCADE
}

