function "parametr"."delete(integer)" {
  text = """

declare 
	 _short_name 			varchar(15);
	 _defaulte 				varchar(200);
	 _parameter_type_id 	int;
	 _need_delete_column 	bool;
	 _catalog_id 			int;
	_sql_in_history 		text;
	_param_in_history 		bool = false;
	_sql_delete 			text = '';
	_sql_check 				text = '';
	_not_default 			bool = false;
begin

	create temp table _errors (id int generated by default as identity(start with 1 increment by 1) not null, "name" varchar(100));
	
	select pl.short_name, pl.default_value, pl.type_id, pl.is_calculation, pl.catalog_id
	into _short_name, _defaulte, _parameter_type_id, _need_delete_column, _catalog_id
	from parametr.list pl
	where pl.id = _parameter_id;

	--проверка на наличие по параметру истории
	
	_sql_in_history = (
						select 'select $1= true 
								from ' || pc.p_table || ' pt 
									inner join period.list pl on pl.date_begin = pt.date_begin 
									where pl.is_working <> true and  pt.parametr_id = $2 and pt.value is not null'
						from  parametr."catalog" pc 
						where  pc.id = _catalog_id
					);

	execute _sql_in_history using _param_in_history, _parameter_id;
	
	if  _param_in_history = true
		then
			insert into _errors ("name") values ('Данный параметр хранится в истории');
	end if;

	if exists(select 1 from parametr.formula where parametr_id = _parameter_id)
		then	
			insert into _errors ("name") values ('По данному рассчётному параметру есть формулы');
	end if;	

	if lower(_short_name) = 'bank'
		then 
			begin
				if exists(
							select 1 
							from parametr.list pl 
								inner join parametr.book pb on pl.id = pb.parametr_id
								inner join payment.batch pab on pab.bank_id = pb.id 
							where pl.id = _parameter_id 
								and pl.catalog_id = 4
						)
					then 
						insert into _errors ("name") values ('По банкам выгружены пачки');
				end if;
			end;
	end if;

	if exists(select 1 from parametr.recalculation where parametr_id = _parameter_id)
		then
			insert into _errors ("name") values ('Есть записи в таблице parameter.re_calculation');
	end if;

	if exists(select 1 from utility.formula where lower(formula) ilike '%'||_short_name||'%')
		then
			insert into _errors ("name") values ('Параметр используется в utility.formula');
	end if;

	if exists(select 1 from utility.formula_result where lower(formula) ilike '%'||_short_name||'%')
		then
			insert into _errors ("name") values ('Параметр используется в utility.formula_result');
	end if;

--проверка: заполнен ли параметр в parametr_transporate
	if _need_delete_column = true
		then 
			begin
				_sql_check = ('(select $1 = case when exists(select 1 from calculation.parametr_transporate where '|| _short_name ||' is not null
								union all
								select 1 from calculation.parametr_transporate_arch  where '|| _short_name ||' is not null
								union all
								select 1 from  recalculation.parametr_transporate  where '|| _short_name ||' is not null ) then true else false end)'
							);
		
				execute  _sql_check using _not_default; 
		
				if _not_default = true
					then
						insert into _errors ("name") values ('Параметр заполнен в parametr_transporate');
				end if;
			end;
	end if;

	if not exists(select * from _errors)
		then
			begin
				--удаление параметра
				delete 
				from parametr.list pl
				where pl.id = _parameter_id;
		
				--удаление колонок в parametrtransporate
				if  _need_delete_column = true
					then
						begin
						
							_sql_delete = ('alter table calculation.parametr_transporate drop column '		|| _short_name || ';
										    alter table calculation.parametr_transporate_arch drop column '	|| _short_name || ';
										    alter table recalculation.parametr_transporate drop column '	|| _short_name || ';'
										  );
				
							execute _sql_delete;
						end;
				end if;
			end;
	end if;

	return query
	select *  
	from _errors;
	
	drop table if exists _errors;

end;
"""
  returnType = TABLE(id integer, name character varying)
  arguments = <
    {
      name = _parameter_id
      type = integer
      mode = IN
    }

  >
  language = plpgsql
  owner = postgres
  comment = """-
=============================================
 author:		макарова е.а.
 create date: 11.02.2021
 description:	полное удаление параметров с проверкой, а также удаление колонок в [parametrtransporate] 
 =============================================
"""
}

